# Copy to .env.local to override public defaults during local development.
# All variables here are public-safe (NEXT_PUBLIC_* is bundled by the client).

# Public contact email used by the primary mailto CTA.
# Use the domain address once Cloudflare Email Routing forwards it (see README → Custom domain).
# When unset, the site falls back to the personal Gmail address.
NEXT_PUBLIC_CONTACT_EMAIL=hola@manuelbotto.com

# WhatsApp number for the wa.me CTA.
# Expected format: country code + area code + number, digits only.
# Example: 54911XXXXXXXX (Argentina mobile). No "+", spaces or dashes.
# Leave empty to hide the WhatsApp CTA entirely instead of linking to a fake number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Personal YouTube channel for the Videos / devlog section.
# Expected format: https://www.youtube.com/@handle (https youtube.com or youtu.be only).
# Leave empty to hide the Videos section entirely instead of linking to a channel that does not exist yet.
NEXT_PUBLIC_YOUTUBE_URL=
