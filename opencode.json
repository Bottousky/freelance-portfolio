{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "subagent_depth": 2,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": {
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "rm -rf *": "deny",
      "*": "ask"
    }
  }
}
